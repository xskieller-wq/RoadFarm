{
  "name": "routefarm",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:reset": "npx supabase db reset",
    "db:status": "npx supabase status",
    "db:verify-feed": "node scripts/verify-feed.mjs",
    "test:supabase": "node scripts/supabase-e2e.mjs",
    "setup:env": "node scripts/setup-env-local.mjs",
    "db:types": "echo \"Run: npx supabase gen types typescript --local > packages/database/src/database.types.ts\"",
    "mobile": "npm run start --workspace @routefarm/mobile"
  },
  "dependencies": {
    "@routefarm/database": "*",
    "@routefarm/shared": "*",
    "@routefarm/supabase": "*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.0"
  }
}
