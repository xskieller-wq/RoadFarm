# Supabase (Phase 1)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Set true to use Supabase auth, onboarding, and home feed (production / full stack)
NEXT_PUBLIC_USE_SUPABASE=false
# In local dev, auth and API stay off unless you set this while Supabase is running:
# NEXT_PUBLIC_SUPABASE_LIVE=true

# Mapbox (Phase 2+)
NEXT_PUBLIC_MAPBOX_TOKEN=
