# Copy to .env.local after: npm run db:reset && npm run db:status
NEXT_PUBLIC_USE_SUPABASE=true
# Local demo (npm run dev): auth/API stay off unless Supabase is running and you set:
# NEXT_PUBLIC_SUPABASE_LIVE=true
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-from-supabase-status
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-from-supabase-status
